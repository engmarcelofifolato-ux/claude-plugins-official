# ============================================================
# Configuração de APIs Reais - GeoRadar Agro
# ============================================================

# BigDataCorp API Key (Opcional)
# Obter em: https://bigdatacorp.com.br
# 500 requisições/mês gratuito
BDC_API_KEY=sua_chave_aqui

# Ambiente (development | production)
NODE_ENV=development

# Porta do servidor
PORT=3000

# URLs de CORS (production)
CORS_ORIGIN=http://localhost:3000,https://seu-dominio.com

# Database (futuro)
# DB_URL=postgresql://usuario:senha@localhost/georadar
