# GeoRadar Agro Backend Configuration

# Server
PORT=3001
NODE_ENV=development

# API Keys (optional - for paid APIs)
# INFOSIMPLES_API_KEY=your_key_here
# SINTEGRA_WS_TOKEN=your_token_here

# Cache Configuration
CACHE_TTL_SICAR=86400
CACHE_TTL_CNPJ=86400
CACHE_TTL_CREDIT=604800
CACHE_TTL_WEATHER=3600

# External APIs
RECEITAWS_API_URL=https://www.receitaws.com.br/v1/cnpj
INMET_API_URL=http://wis2bra.inmet.gov.br
SIDRA_API_URL=https://apisidra.ibge.gov.br/values
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast

# CORS Configuration
CORS_ORIGIN=*
